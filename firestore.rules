rules_version = '2';

// Pinoy Mart — Firestore Security Rules
//
// Model:
//   • Public collections (categories, branches, products, promos): anyone can READ,
//     only authenticated super-admins can WRITE.
//   • orders: anyone can CREATE (to capture WhatsApp orders),
//     only super-admins can READ/UPDATE/DELETE.
//   • admins: only super-admins can READ. No writes from client (use seed script
//     or Firebase Console).

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super';
    }

    // ─── Public catalog data ────────────────────────────────────────────────
    match /categories/{slug} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─── Orders ────────────────────────────────────────────────────────────
    // Customers create orders (no auth needed).
    // Only super-admins can read or modify orders.
    match /orders/{orderId} {
      allow create: if
        // Basic shape sanity checks
        request.resource.data.keys().hasAll(
          ['branchId', 'fulfillment', 'customerName', 'customerContact', 'items', 'subtotal', 'status', 'createdAt']
        ) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.subtotal is number &&
        request.resource.data.subtotal >= 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 200 &&
        request.resource.data.fulfillment in ['pickup', 'delivery'];
      allow read, update, delete: if isSuperAdmin();
    }

    // ─── Admins registry ───────────────────────────────────────────────────
    // Created by the seed script (or by manually adding via Firebase Console).
    // Client can read its own admin doc to verify role; no writes from client.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
